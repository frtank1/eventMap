# dev | prod. В prod обязательны JWT_SECRET (не dev-дефолт) и CORS_HOSTS — иначе приложение не стартует.
APP_ENV=dev

DB_URL=jdbc:postgresql://localhost:5432/eventmap
DB_USER=eventmap
DB_PASSWORD=eventmap

JWT_SECRET=change-me
JWT_ISSUER=eventmap
JWT_AUDIENCE=eventmap-app

# Разрешённые CORS-хосты через запятую (прим.: app.eventmap.kz,eventmap.kz). Пусто = anyHost (только dev!)
CORS_HOSTS=

PORT=8080

# Фото и старые ролики (Cloudflare R2 / MinIO). Пусто = DB fallback, не для массового продакшена.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# Новые ролики: storage (старый поток) | mux. Сначала обновить мобильный клиент.
VIDEO_PROVIDER=storage
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_MAX_UPLOADS_PER_DAY=20
MUX_MAX_DURATION_SECONDS=120

# Push (FCM HTTP v1) — из service-account JSON Firebase. Пусто = пуши выключены (no-op).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Приватный ключ целиком; перевод строк можно как \n (нормализуется): "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FCM_PRIVATE_KEY=
