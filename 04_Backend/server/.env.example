# dev | prod. В prod обязательны JWT_SECRET (не dev-дефолт) и CORS_HOSTS — иначе приложение не стартует.
APP_ENV=dev

DB_URL=jdbc:postgresql://localhost:5432/eventmap
DB_USER=eventmap
DB_PASSWORD=eventmap

JWT_SECRET=change-me
JWT_ISSUER=eventmap
JWT_AUDIENCE=eventmap-app

# Разрешённые CORS-хосты через запятую (прим.: app.eventmap.kz,eventmap.kz). Пусто = anyHost (только dev!)
CORS_HOSTS=

PORT=8080
