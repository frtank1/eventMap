<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Используется для входа по биометрии</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Геолокация нужна для чек-инов на точках квестов и отметки «я тоже здесь» на событиях рядом</string>
	<key>NSCameraUsageDescription</key>
	<string>Камера нужна для съёмки видео-моментов на событиях</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Микрофон нужен для записи звука в видео-моментах</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Подключение к локальному серверу разработки</string>
	<!-- DEV ONLY: разрешает HTTP к локальному бэкенду. Убрать перед релизом. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
